# ---------------------------------------------------------------------------
# Cafe Dhara backend — environment template.
# Copy to `.env` and fill in real values. NEVER commit the real .env file.
# All placeholders below are non-secret examples only.
# ---------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/cafe_dhara

# JWT secrets (generate strong random strings for real deployments)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:3000

# QR signing secret (for signing customer table QR tokens)
QR_SECRET=change-me-qr-secret

# Seed owner account (used by `npm run seed`; override for real deployments)
SEED_OWNER_EMAIL=owner@cafedhara.local
SEED_OWNER_PASSWORD=ChangeMe123!
